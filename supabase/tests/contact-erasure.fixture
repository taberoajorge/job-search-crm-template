\set ON_ERROR_STOP on
begin;
delete from crm_private.settings;
insert into auth.users(id,email) values('00000000-0000-4000-8000-000000000081','erasure@example.invalid'),('00000000-0000-4000-8000-000000000082','other-erasure@example.invalid');
insert into auth.sessions(id,user_id) values('00000000-0000-4000-8000-000000000083','00000000-0000-4000-8000-000000000081');
insert into crm_private.settings(owner_id,mcp_resource) values('00000000-0000-4000-8000-000000000081','https://example.invalid/functions/v1/mcp');
select set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000081","session_id":"00000000-0000-4000-8000-000000000083","role":"authenticated"}',false);
create or replace function pg_temp.expect(value boolean,label text) returns void language plpgsql as $$begin if value is distinct from true then raise exception 'FAILED: %',label;end if;end$$;
create function pg_temp.fail_erasure_audit() returns trigger language plpgsql as $$begin if new.action='contacts.erase' then raise exception 'synthetic audit failure';end if;return new;end$$;
do $$
declare owner uuid=auth.uid();company jsonb;job jsonb;contact jsonb;other jsonb;outreach jsonb;interview jsonb;p jsonb;r jsonb;request jsonb;original jsonb;replay jsonb;task jsonb;lease jsonb;foreign_id uuid;funnel jsonb;audits bigint;legacy text='legacy-contact';import_input jsonb;before_inventory jsonb;
begin
 company=public.crm_operation('companies.upsert',jsonb_build_object('name','Fixture Company','idempotency_key',gen_random_uuid()));
 job=public.crm_operation('jobs.upsert',jsonb_build_object('company_id',company->'id','title','Fixture Role','idempotency_key',gen_random_uuid()));
 contact=public.crm_operation('contacts.upsert',jsonb_build_object('company_id',company->'id','job_id',job->'id','name','Synthetic Person','email','synthetic@example.invalid','draft_message','synthetic secret','status','connected','idempotency_key',gen_random_uuid()));
 other=public.crm_operation('contacts.upsert',jsonb_build_object('company_id',company->'id','name','Unrelated Person','idempotency_key',gen_random_uuid()));
 contact=contact->'contact';other=other->'contact';
 outreach=public.crm_operation('outreach.draft',jsonb_build_object('contact_id',contact->'id','body','synthetic personal body','channel','manual','kind','message','idempotency_key',gen_random_uuid()));
 interview=public.crm_operation('interviews.upsert',jsonb_build_object('job_id',job->'id','state','planned','timezone','UTC','interviewer_ids',jsonb_build_array(contact->'id',other->'id'),'interviewer_notes','synthetic personal interview text','notes','keep interview facts','idempotency_key',gen_random_uuid()));
 insert into public.legacy_links(user_id,entity_type,entity_id,import_namespace,legacy_id) values(owner,'contacts',(contact->>'id')::uuid,'erasure-fixture',legacy);
 -- Original imported identity has a durable stable child receipt, independently of mutable contact version.
 import_input=jsonb_build_object('entity_type','contacts','legacy_id',legacy,'data',jsonb_build_object('id',contact->'id','company_id',company->'id','name','Synthetic Person'));
 insert into public.mutation_receipts(user_id,idempotency_key,operation,payload_hash,response) values(owner,md5(jsonb_build_array(owner,'erasure-fixture','contacts',legacy)::text)::uuid,'import.contacts',encode(extensions.digest(import_input::text,'sha256'),'hex'),contact);
 task=public.crm_operation('tasks.submit',jsonb_build_object('kind','bulk_import','payload',jsonb_build_object('import_namespace','erasure-fixture','records',jsonb_build_array(import_input)),'idempotency_key',gen_random_uuid()));
 lease=crm_private.worker_claim();perform set_config('crm.actor_kind','',true);
 insert into crm_private.embeddings(user_id,entity_type,entity_id,vector,model,source_version) values(owner,'contacts',(contact->>'id')::uuid,array[1.0,0.0],'fixture',1);
 p=public.crm_operation('contacts.preview_erasure',jsonb_build_object('id',contact->'id'));
 perform pg_temp.expect(p->'inventory'->>'outreach'='1' and p->'inventory'->>'interviews'='1' and p->'inventory'->>'import_tasks'='1','preview enumerates copies');
 request=jsonb_build_object('id',contact->'id','expected_version',p->'expected_version','inventory_hash',p->'inventory_hash','owner_reviewed',true,'idempotency_key',gen_random_uuid());
 r=public.crm_operation('contacts.erase',jsonb_build_object('id',contact->'id','confirmation',true,'idempotency_key',gen_random_uuid()));
 perform pg_temp.expect(r->'error'->>'code'='VALIDATION_ERROR','confirmation true alone rejected');
 update public.outreach_events set body='changed synthetic body' where id=(outreach->>'id')::uuid;
 r=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(r->'error'->>'code'='CONFLICT','changed inventory rejects execute');
 perform pg_temp.expect((select name='Synthetic Person' from public.contacts where id=(contact->>'id')::uuid),'stale inventory is atomic');
 p=public.crm_operation('contacts.preview_erasure',jsonb_build_object('id',contact->'id'));
 request=jsonb_build_object('id',contact->'id','expected_version',p->'expected_version','inventory_hash',p->'inventory_hash','owner_reviewed',true,'idempotency_key',gen_random_uuid());
 r=public.crm_operation('contacts.erase',jsonb_set(request,'{expected_version}','999'));
 perform pg_temp.expect(r->'error'->>'code'='CONFLICT','stale contact version denied');
 perform set_config('crm.actor_kind','worker',true);
 r=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','worker actor denied');
 perform set_config('crm.actor_kind','',true);
 if to_regclass('auth.oauth_clients') is not null then
  -- Real GoTrue schema; native fallback supplies the smaller authorization fixture.
  execute $oauth$insert into auth.oauth_clients(id,registration_type,redirect_uris,grant_types,client_type,token_endpoint_auth_method) values('00000000-0000-4000-8000-000000000084','manual','https://example.invalid/callback','authorization_code','public','none')$oauth$;
  execute $oauth$insert into auth.oauth_consents(id,user_id,client_id,scopes) values(gen_random_uuid(),$1,'00000000-0000-4000-8000-000000000084','openid')$oauth$ using owner;
 else
  insert into auth.oauth_consents(user_id,client_id) values(owner,'00000000-0000-4000-8000-000000000084');
 end if;
 perform set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000081","session_id":"00000000-0000-4000-8000-000000000083","client_id":"00000000-0000-4000-8000-000000000084","role":"authenticated"}',true);
 r=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','OAuth agent denied even with reviewed boolean');
 perform set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000082","role":"authenticated"}',true);
 r=public.crm_operation('contacts.preview_erasure',jsonb_build_object('id',contact->'id'));
 perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','cross-owner preview denied');
 r=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','cross-owner erase denied');
 perform set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000081","session_id":"00000000-0000-4000-8000-000000000083","role":"authenticated"}',true);
 insert into public.companies(user_id,name) values('00000000-0000-4000-8000-000000000082','Foreign Company') returning id into foreign_id;
 insert into public.contacts(user_id,company_id,name) values('00000000-0000-4000-8000-000000000082',foreign_id,'Foreign Person') returning id into foreign_id;
 perform pg_temp.expect(public.crm_operation('contacts.preview_erasure',jsonb_build_object('id',foreign_id))->'error'->>'code'='NOT_FOUND','owner cannot preview foreign contact');
 execute 'create trigger test_erasure_failure before insert on public.audit_events for each row execute function pg_temp.fail_erasure_audit()';
 before_inventory=crm_private.erasure_inventory(owner,(contact->>'id')::uuid);
 r=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(r->'error'->>'code'='TEMPORARY_FAILURE','audit failure reports safe error');
 perform pg_temp.expect(crm_private.erasure_inventory(owner,(contact->>'id')::uuid)=before_inventory,'audit failure rolls back all erasure copies');
 perform pg_temp.expect(not exists(select 1 from public.mutation_receipts where idempotency_key=(request->>'idempotency_key')::uuid),'failed erase has no receipt');
 execute 'drop trigger test_erasure_failure on public.audit_events';
 perform pg_temp.expect(public.crm_operation('dashboard.summary','{}')->'workspace'->>'followup_count'='1','connected contact actionable before erase');
 funnel=public.crm_operation('dashboard.summary','{}')->'funnel';
 original=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(original->>'erased'='true','erasure succeeds');
 begin perform crm_private.worker_import((lease->>'id')::uuid,(lease->>'lease_token')::uuid);raise exception 'Expected cancelled lease';exception when sqlstate 'CR001' then perform pg_temp.expect(SQLERRM::jsonb->>'code'='FORBIDDEN','pre-erasure import lease revoked');end;
 perform pg_temp.expect((select name='Contacto eliminado' and email is null and draft_message='' from public.contacts where id=(contact->>'id')::uuid),'canonical contact minimized');
 perform pg_temp.expect((select name='Unrelated Person' from public.contacts where id=(other->>'id')::uuid),'unrelated contact unchanged');
 perform pg_temp.expect((select body='' and contact_id=(contact->>'id')::uuid from public.outreach_events where id=(outreach->>'id')::uuid),'outreach tombstone retains relationship');
 perform pg_temp.expect((select interviewer_notes='' and notes='keep interview facts' and cardinality(interviewer_ids)=2 from public.interviews where id=(interview->>'id')::uuid),'interview facts and participants preserved');
 perform pg_temp.expect(not exists(select 1 from crm_private.embeddings where entity_id=(contact->>'id')::uuid),'embedding removed');
 perform pg_temp.expect(not exists(select 1 from public.audit_events where entity_id=(contact->>'id')::uuid and (before::text||after::text) like '%synthetic@example.invalid%'),'old and new audits minimized');
 perform pg_temp.expect(not exists(select 1 from public.crm_jobs where id=(task->>'task_id')::uuid and payload::text like '%Synthetic Person%'),'import payload minimized');
 perform pg_temp.expect(public.crm_operation('dashboard.summary','{}')->'funnel'=funnel,'funnel unchanged');
 perform pg_temp.expect(not exists(select 1 from public.audit_events where user_id=owner and coalesce(before::text,'')||coalesce(after::text,'') ~ '(synthetic@example\.invalid|Synthetic Person|synthetic secret|synthetic personal|changed synthetic body)'),'no audit body keeps erased personal data');
 perform pg_temp.expect(not exists(select 1 from public.mutation_receipts where user_id=owner and response::text ~ '(synthetic@example\.invalid|Synthetic Person|synthetic secret|synthetic personal|changed synthetic body)'),'no receipt keeps erased personal data');
 perform pg_temp.expect(not exists(select 1 from public.crm_jobs where user_id=owner and payload::text||coalesce(result::text,'') ~ '(synthetic@example\.invalid|Synthetic Person|synthetic secret|synthetic personal)'),'no task keeps erased personal data');
 perform pg_temp.expect(exists(select 1 from public.legacy_links where user_id=owner and entity_id=(contact->>'id')::uuid),'legacy provenance kept as anti-replay marker');
 perform pg_temp.expect(exists(select 1 from public.mutation_receipts where user_id=owner and operation='interviews.upsert' and response->>'id'=interview->>'id' and response->>'erased'='true' and response ? 'state' and response ? 'created_at' and not response ? 'interviewer_notes' and not response ? 'notes'),'erased interview receipt keeps id, state and timestamps only');
 perform pg_temp.expect(public.crm_operation('dashboard.summary','{}')->'workspace'->>'followup_count'='0','erased contact excluded from actionable followups');
 select count(*) into audits from public.audit_events;
 replay=public.crm_operation('contacts.erase',request);
 perform pg_temp.expect(replay=original and (select count(*) from public.audit_events)=audits,'exact erasure replay has one effect');
 r=public.crm_operation('contacts.erase',jsonb_set(request,'{inventory_hash}',to_jsonb(repeat('a',64))));
 perform pg_temp.expect(r->'error'->>'code'='IDEMPOTENCY_CONFLICT','changed erasure replay denied');
 r=public.crm_operation('contacts.upsert',jsonb_build_object('company_id',company->'id','job_id',job->'id','name','Synthetic Person','email','synthetic@example.invalid','draft_message','synthetic secret','status','connected','idempotency_key',(select idempotency_key from public.mutation_receipts where operation='contacts.upsert' and response->'contact'->>'id'=contact->>'id' limit 1)));
 perform pg_temp.expect(r->'contact'->>'erased'='true' and not (r->'contact') ? 'email','old mutation replay returns minimized tombstone');
 r=public.crm_operation('contacts.upsert',jsonb_build_object('id',contact->'id','expected_version',2,'name','Recreated','idempotency_key',gen_random_uuid()));
 perform pg_temp.expect(r->'error'->>'code'='CONFLICT','new key cannot resurrect erased UUID');
 task=public.crm_operation('tasks.submit',jsonb_build_object('kind','bulk_import','payload',jsonb_build_object('import_namespace','erasure-fixture','records',jsonb_build_array(import_input)),'idempotency_key',gen_random_uuid()));
 perform pg_temp.expect(task->'error'->>'code'='CONFLICT','new import submission rejects erased identity before payload retention');
 perform pg_temp.expect((select name='Contacto eliminado' from public.contacts where id=(contact->>'id')::uuid),'old import receipt never recreates identity');
 perform pg_temp.expect(not has_function_privilege('authenticated','crm_private.contact_erasure(uuid,text,jsonb)','EXECUTE'),'private erase function denied');
end $$;
rollback;
