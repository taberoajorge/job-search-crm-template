begin;
delete from crm_private.settings;
insert into auth.users(id,email) values('00000000-0000-4000-8000-000000000091','guide@example.invalid'),('00000000-0000-4000-8000-000000000092','other-guide@example.invalid');
insert into auth.sessions(id,user_id) values('00000000-0000-4000-8000-000000000093','00000000-0000-4000-8000-000000000091');
insert into crm_private.settings(owner_id,mcp_resource) values('00000000-0000-4000-8000-000000000091','https://example.invalid/functions/v1/mcp');
select set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000091","session_id":"00000000-0000-4000-8000-000000000093","role":"authenticated","aud":"authenticated"}',true);
create or replace function pg_temp.expect(value boolean,label text) returns void language plpgsql as $$ begin if value is distinct from true then raise exception 'FAILED: %',label;end if;end $$;
do $$ declare c public.companies;j public.jobs;j2 public.jobs;cv public.resumes;w public.automation_work;p jsonb;profile jsonb;r jsonb;request jsonb;rev text;round jsonb;g jsonb;s jsonb;save jsonb;content jsonb;q jsonb;pack_input jsonb;begin
 insert into public.companies(user_id,name) values(auth.uid(),'Synthetic service platform') returning * into c;
 insert into public.resumes(user_id,label,country,track,checksum,media_type,storage_path,active) values(auth.uid(),'Synthetic','Mexico','Frontend',repeat('a',64),'application/pdf',auth.uid()::text||'/guide.pdf',true) returning * into cv;
 profile=jsonb_build_object('id','frontend-MX','country','MX','track','frontend','resume_id',cv.id,'checksum',cv.checksum,'authorized_country',true,'remote',true,'terms',jsonb_build_array('React'),'exclusions','[]'::jsonb,'allow_unknown_salary',true,'salary_min',null,'currency',null,'salary_period',null);
 p=jsonb_build_object('enabled',false,'interval_hours',2,'revalidate_hours',24,'timezone','UTC','profiles',jsonb_build_array(profile),'sources',jsonb_build_array('exa'),'model','default','effort','medium','candidates_per_profile',3,'exa_per_run_usd',0.1,'exa_daily_usd',1,'exa_monthly_usd',1,'digest_email',false,'closure_email',false);
 r=public.crm_operation('automation.configure',jsonb_build_object('policy',p,'expected_version',0,'idempotency_key',gen_random_uuid()));perform pg_temp.expect(not r ? 'error','configure');
 insert into public.jobs(user_id,company_id,title,stage,applied_at,resume_id) values(auth.uid(),c.id,'Internal tools','applied',now(),cv.id) returning * into j;
 request=jsonb_build_object('id',j.id,'stage','interview','expected_version',j.version,'idempotency_key',gen_random_uuid());
 r=public.crm_operation('jobs.transition',request);perform pg_temp.expect(not r ? 'error','invitation commits: '||r::text);
 perform pg_temp.expect(public.crm_operation('jobs.transition',request)=r,'exact transition replay');
 perform pg_temp.expect((select count(*)=1 from public.automation_work where job_id=j.id and kind='interview'),'one no-date invitation');
 perform pg_temp.expect((select active from public.automation_interview_intents where job_id=j.id),'durable confirmed intent');
 r=public.crm_operation('automation.pack.get',jsonb_build_object('job_id',j.id));perform pg_temp.expect(r->>'stale'='false' and r->'preparation'->>'paused'='true','truthful paused request and no pack');
 r=public.crm_operation('automation.claim',jsonb_build_object('executor_id',gen_random_uuid(),'content_version',2,'idempotency_key',gen_random_uuid()));perform pg_temp.expect(r->'work'='null'::jsonb,'pause prevents dispatch');
 request=jsonb_build_object('scope','interview','job_id',j.id,'on_demand',true,'idempotency_key',gen_random_uuid(),'preparation_context',jsonb_build_array(jsonb_build_object('topic','english_level','fact','B2','confirmed',true)));
 r=public.crm_operation('automation.trigger',request);perform pg_temp.expect(not r ? 'error','explicit preparation permitted');perform pg_temp.expect(public.crm_operation('automation.trigger',request)=r,'manual request replay');
 r=public.crm_operation('automation.claim',jsonb_build_object('executor_id',gen_random_uuid(),'idempotency_key',gen_random_uuid()));perform pg_temp.expect(r->'work'='null'::jsonb,'old worker cannot claim v2');
 r=public.crm_operation('automation.claim',jsonb_build_object('executor_id',gen_random_uuid(),'content_version',3,'idempotency_key',gen_random_uuid()));perform pg_temp.expect(r->'error'->>'code'='VALIDATION_ERROR','unsupported worker version rejected at SQL boundary');
 r=public.crm_operation('automation.claim',jsonb_build_object('executor_id',gen_random_uuid(),'content_version',2,'idempotency_key',gen_random_uuid()));select * into w from public.automation_work where id=(r->'work'->>'id')::uuid;perform pg_temp.expect(w.kind='interview','new worker claims interview while saved pause remains');
 select revision into rev from public.automation_interview_intents where job_id=j.id;
 round=public.crm_operation('interviews.upsert',jsonb_build_object('job_id',j.id,'state','planned','timezone','UTC','language','en','format','hr','idempotency_key',gen_random_uuid()));perform pg_temp.expect(not round ? 'error','round without date saved');
 perform pg_temp.expect((select count(*)=1 from public.automation_work where job_id=j.id and kind='interview'),'concurrent first appointment coalesces running work');
 perform pg_temp.expect((select revision<>rev from public.automation_interview_intents where job_id=j.id),'round invalidates target revision');
 select revision into rev from public.automation_interview_intents where job_id=j.id;
 r=public.crm_operation('interviews.upsert',jsonb_build_object('id',round->'id','expected_version',round->'version','notes','Unrelated note','idempotency_key',gen_random_uuid()));perform pg_temp.expect(not r ? 'error','note edit');
 perform pg_temp.expect((select revision=rev from public.automation_interview_intents where job_id=j.id),'note edit does not purchase research');round=r;
 request=jsonb_build_object('scope','interview','job_id',j.id,'interview_id',gen_random_uuid(),'idempotency_key',gen_random_uuid());r=public.crm_operation('automation.trigger',request);perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','foreign round denied');
 s=jsonb_build_object('explanation_es','El cliente reserva un servicio; la plataforma coordina su entrega.','explanation_en','The customer books a service; the platform coordinates delivery.','coverage','supported','evidence',jsonb_build_array(jsonb_build_object('url','https://example.invalid/product','quote','Customers book services','checked_at','2026-10-05T00:00:00Z')));
 g=jsonb_build_object('depth','interview','offering',s,'customers',s,'revenue',s,'workflow',s,'technology',s,'hiring_process',s,'example',s,'example_kind','illustrative','gaps','[]'::jsonb,'review_status','needs_review');
 save=jsonb_build_object('idempotency_key',gen_random_uuid(),'work_id',w.id,'lease_token',w.lease_token,'expected_version',w.version,'company_id',c.id,'company_version',c.version,'expected_guide_version',0,'content',g,'source_fingerprint',repeat('b',64));
 r=public.crm_operation('automation.company-guide.save',save);perform pg_temp.expect(r->'guide'->>'version'='1','guarded company guide saved');perform pg_temp.expect(public.crm_operation('automation.company-guide.save',save)=r,'guide exact replay');
 r=public.crm_operation('automation.company-guide.save',save||jsonb_build_object('idempotency_key',gen_random_uuid(),'expected_guide_version',1,'company_id',gen_random_uuid()));perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','guide cannot target unrelated company');
 r=public.crm_operation('automation.company-guide.save',save||jsonb_build_object('idempotency_key',gen_random_uuid(),'lease_token',gen_random_uuid()));perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','invalid lease denied');
 r=public.crm_operation('automation.company-guide.get',jsonb_build_object('company_id',c.id));perform pg_temp.expect(r->'guide'->>'version'='1','shared business evidence reads independently of CV');
 select * into j from public.jobs where id=j.id;
 q=jsonb_build_object('question_es','¿Cómo diseñarías el flujo?','question_en','How would you design the workflow?','answer_es','Partiría del usuario.','answer_en','I would start with the user.','cv_evidence','Synthetic project');
 content=jsonb_build_object('introduction_es','Introducción','introduction_en','Introduction','questions',jsonb_build_array(q,q,q),'employer_questions_es','[]'::jsonb,'employer_questions_en','[]'::jsonb,'gaps','[]'::jsonb,'english_required',null,'interview_language','en','company_facts','[]'::jsonb,'predictions',true,'practice_completed',false,
 'content_version',2,'depth','interview','coverage','partial','company_guide',g,'guide_version',1,'role_guide',jsonb_build_object('area',s,'contribution',s,'requirements','[]'::jsonb),'rounds',crm_private.interview_context(auth.uid(),j.id),'context_revision',rev,
 'communication',jsonb_build_object('english_level','B2','explain_back_es','El cliente reserva y operaciones entrega.','explain_back_en','Customers book and operations delivers.','vocabulary','[]'::jsonb,'clarification_en','[]'::jsonb,'stories','[]'::jsonb));
 pack_input=jsonb_build_object('idempotency_key',gen_random_uuid(),'work_id',w.id,'lease_token',w.lease_token,'expected_version',w.version,'job_id',j.id,'resume_id',cv.id,'job_version',j.version,'resume_version',cv.version,'company_version',c.version,'expected_pack_version',0,'content',content,'model','synthetic','effort','medium');
 r=public.crm_operation('automation.pack.save',pack_input);perform pg_temp.expect(r->'pack'->>'version'='1','V2 contextual pack saved: '||r::text);perform pg_temp.expect(public.crm_operation('automation.pack.save',pack_input)=r,'V2 pack exact replay');
 r=public.crm_operation('automation.pack.get',jsonb_build_object('job_id',j.id));perform pg_temp.expect(r->>'stale'='false','V2 current guide and round not stale');
 r=public.crm_operation('automation.pack.save',pack_input||jsonb_build_object('idempotency_key',gen_random_uuid(),'content',jsonb_set(content,'{communication,english_level}','"Invented fluency"')));perform pg_temp.expect(r->'error'->>'code'='VALIDATION_ERROR','unconfirmed English rejected at database boundary');
 r=public.crm_operation('automation.pack.save',pack_input||jsonb_build_object('idempotency_key',gen_random_uuid(),'content',jsonb_set(content,'{communication,stories}','[{"title":"Missing evidence"}]')));perform pg_temp.expect(r->'error'->>'code'='VALIDATION_ERROR','incomplete story rejected at database boundary');
 r=public.crm_operation('automation.pack.save',pack_input||jsonb_build_object('idempotency_key',gen_random_uuid(),'content',jsonb_set(content,'{context_revision}','"outdated"')));perform pg_temp.expect(r->'error'->>'code'='CONFLICT','material round conflict preserves pack');
 r=public.crm_operation('interviews.upsert',jsonb_build_object('id',round->'id','expected_version',round->'version','format','technical','language','es','idempotency_key',gen_random_uuid()));perform pg_temp.expect(not r ? 'error','material round update');round=r;
 perform pg_temp.expect(public.crm_operation('automation.pack.get',jsonb_build_object('job_id',j.id))->>'stale'='true','material round makes prior pack stale');
 insert into public.jobs(user_id,company_id,title,stage,applied_at,resume_id) values(auth.uid(),c.id,'Customer-facing portal','applied',now(),cv.id) returning * into j2;
 r=public.crm_operation('jobs.upsert',jsonb_build_object('id',j2.id,'expected_version',j2.version,'stage','interview','idempotency_key',gen_random_uuid()));perform pg_temp.expect(r->'error'->>'code'='VALIDATION_ERROR','upsert cannot bypass canonical stage transition');
 r=public.crm_operation('jobs.upsert',jsonb_build_object('company_id',c.id,'title','Confirmed invitation creation','stage','interview','applied_at',now(),'resume_id',cv.id,'idempotency_key',gen_random_uuid()));perform pg_temp.expect(not r ? 'error','upsert invitation creation: '||r::text);select * into j2 from public.jobs where id=(r->>'id')::uuid;
 perform pg_temp.expect((select active from public.automation_interview_intents where job_id=j2.id),'upsert also captures confirmed invitation');
 r=public.crm_operation('interviews.upsert',jsonb_build_object('id',round->'id','expected_version',round->'version','state','cancelled','idempotency_key',gen_random_uuid()));perform pg_temp.expect(not r ? 'error','cancel round');perform pg_temp.expect((select not active from public.automation_interview_intents where job_id=j.id),'cancellation prevents new dispatch');
 r=public.crm_operation('jobs.transition',jsonb_build_object('id',j.id,'stage','interview','expected_version',1,'idempotency_key',gen_random_uuid()));perform pg_temp.expect(r->'error'->>'code'='CONFLICT','conflicting transition remains uncommitted');
 perform pg_temp.expect((select count(*)=1 from public.automation_work where job_id=j.id and kind='interview'),'failed/offline replay creates no additional intent');
 -- Known conflicts preserve the prior checkpoint and use a distinct explicit work identity.
 update public.automation_work set state='blocked',error='CRM_CONFLICT',lease_token=null,lease_until=null,executor_id=null,checkpoint=checkpoint||jsonb_build_object('interview_pack',content,'requests',jsonb_build_object('pack',pack_input)) where id=w.id;
 request=jsonb_build_object('scope','interview','job_id',j.id,'on_demand',true,'idempotency_key',gen_random_uuid());
 r=public.crm_operation('automation.trigger',request);perform pg_temp.expect(not r ? 'error' and r->'work_ids'->>0<>w.id::text,'explicit recovery creates new work identity: '||r::text);
 perform pg_temp.expect(public.crm_operation('automation.trigger',request)=r,'conflict recovery request replays exactly');
 perform pg_temp.expect((select state='cancelled' and checkpoint->'interview_pack'=content and checkpoint->'requests'->'pack'=pack_input from public.automation_work where id=w.id),'superseded conflicting content/request retained');
 perform pg_temp.expect((select count(*)=1 from public.automation_work where job_id=j.id and state in ('queued','running','waiting','blocked') and kind='interview'),'only replacement active');
 update public.automation_work set state='blocked',error='EXA_CREATE_AMBIGUOUS' where job_id=j.id and state='queued';
 request=request||jsonb_build_object('idempotency_key',gen_random_uuid());r=public.crm_operation('automation.trigger',request);
 perform pg_temp.expect((select count(*)=2 from public.automation_work where job_id=j.id and kind='interview'),'ambiguous create never forks another work');
 perform pg_temp.expect((select count(*)=1 from public.automation_work where job_id=j.id and state='blocked' and error='EXA_CREATE_AMBIGUOUS'),'ambiguous create remains blocked');
 perform set_config('request.jwt.claims','{"sub":"00000000-0000-4000-8000-000000000092","role":"authenticated"}',true);
 r=public.crm_operation('automation.company-guide.get',jsonb_build_object('company_id',c.id));perform pg_temp.expect(r->'error'->>'code'='FORBIDDEN','other owner cannot read guide');
end $$;
set local role authenticated;
select pg_temp.expect((select count(*)=0 from public.automation_company_guides),'guide RLS');
select pg_temp.expect((select count(*)=0 from public.automation_interview_intents),'private context RLS');
reset role;
rollback;
