# Copy to .env.local. Never commit the copy.
# Server-only values stay in the Edge/provider secret store.
CRM_ALLOWED_ORIGINS=http://localhost:5173
CRM_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
